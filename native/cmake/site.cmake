# site.cmake — cmake -DOUT=<source.cpp> -DNAME=<symbol> -DFILES=<list file> -P site.cmake, run in
# the repository's root: packs the site's files the list names (paths from the root) into one
# gzipped tar archive and writes it as a forte::Site (plugin/site.h) named NAME, for a plugin's
# window to serve its instrument's page from (editor.h). forte_site() (forte.cmake) makes the list.
file(STRINGS ${FILES} files)
get_filename_component(dir ${OUT} DIRECTORY)
set(archive ${dir}/${NAME}.tar.gz)
file(ARCHIVE_CREATE OUTPUT ${archive} PATHS ${files} FORMAT paxr COMPRESSION GZip MTIME 0)
file(READ ${archive} hex HEX)
string(LENGTH "${hex}" n)
math(EXPR size "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
file(WRITE ${OUT} "// generated by cmake/site.cmake from the site's files. Do not edit.\n#include \"site.h\"\n"
  "namespace {\nconst unsigned char bytes[] = {\n${bytes}0x00};\n}\n"
  "extern const forte::Site ${NAME};\nconst forte::Site ${NAME}{bytes, ${size}};\n")
