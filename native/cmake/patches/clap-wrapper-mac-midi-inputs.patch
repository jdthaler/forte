+// The MIDI inputs: every one is connected but those the user turned off in Audio/MIDI
+// Settings, which are remembered by name (so a keyboard plugged in later is connected too).
+static NSString *const kMidiInputsOff = @"MIDIInputsOff";
+
+static std::set<std::string> midiInputsOff()
+{
+  std::set<std::string> off;
+  for (id name in [[NSUserDefaults standardUserDefaults] arrayForKey:kMidiInputsOff])
+    if ([name isKindOfClass:[NSString class]]) off.insert([name UTF8String]);
+  return off;
+}
+
+static std::vector<std::string> midiInputNames()
+{
+  std::vector<std::string> names;
+  try
+  {
+    RtMidiIn probe;
+    for (unsigned int i = 0; i < probe.getPortCount(); i++) names.push_back(probe.getPortName(i));
+  }
+  catch (RtMidiError &error)
+  {
+    error.printMessage();
+  }
+  return names;
+}
+
+// open every MIDI input but those turned off, in place of the ones open now
+static void connectMidiInputs()
+{
+  auto *standaloneHost = freeaudio::clap_wrapper::standalone::getStandaloneHost();
+  const auto off = midiInputsOff();
+  const auto names = midiInputNames();
+  for (auto &m : standaloneHost->midiIns) m.reset();
+  standaloneHost->midiIns.clear();
+  standaloneHost->currentMidiPorts.clear();
+  standaloneHost->numMidiPorts = (uint32_t)names.size();
+  for (unsigned int i = 0; i < names.size(); i++)
+  {
+    if (off.count(names[i])) continue;
+    try
+    {
+      auto midiIn = std::make_unique<RtMidiIn>();
+      midiIn->openPort(i);
+      midiIn->setCallback(standaloneHost->midiCallback, standaloneHost);
+      standaloneHost->midiIns.push_back(std::move(midiIn));
+      standaloneHost->currentMidiPorts.push_back(i);
+    }
+    catch (RtMidiError &error)
+    {
+      error.printMessage();
+    }
+  }
+}
+
