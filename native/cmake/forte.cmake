# forte.cmake — building an instrument.

set(FORTE_PLUGIN_DIR ${CMAKE_CURRENT_LIST_DIR}/../plugin)
set(FORTE_WEB_DIR ${CMAKE_CURRENT_LIST_DIR}/../web)
set(FORTE_ICON_DIR ${CMAKE_CURRENT_LIST_DIR}/../icons) # the standalones' icons (tools/make-icons.py)

# forte_add_plugin(<slug> NAME <name> VERSION <x.y.z> AU_SUBTYPE <code> INSTRUMENT <library> [ACCENT <#rrggbb>])
#
# <library> holds the instrument's engine and its InstrumentInfo (it defines
# forte_instrument()). ACCENT, the window's colour, defaults to FORTE_ACCENT (<slug>-info.cmake). Makes forte_<slug>_clap, _vst3, _auv2 (macOS) and _standalone (with
# native/icons/<slug>.icns and .ico as its icon on macOS and Windows) into ${CMAKE_BINARY_DIR}/plugins, and forte_<slug>_all to build them all. Plugin ids:
# net.jthaler.forte.<slug> (CLAP, bundles), AU manufacturer Frte (docs/PLUGINS.md).
function(forte_add_plugin slug)
  cmake_parse_arguments(A "" "NAME;VERSION;AU_SUBTYPE;INSTRUMENT;ACCENT" "" ${ARGN})
  if (NOT A_ACCENT)
    set(A_ACCENT "${FORTE_ACCENT}")
  endif()
  # the version in the instrument's InstrumentInfo (<slug>-params.h); the WebAssembly is built
  # without it, so bumping a version changes only <slug>-info.cmake and the plugins
  target_compile_definitions(${A_INSTRUMENT} PRIVATE "FORTE_INSTRUMENT_VERSION=\"${A_VERSION}\"")
  set(impl forte_${slug}_impl)
  add_library(${impl} STATIC ${FORTE_PLUGIN_DIR}/entry-impl.cpp)
  target_link_libraries(${impl} PUBLIC forte_plugin ${A_INSTRUMENT})
  string(REPLACE "#" "" rgb "${A_ACCENT}") # (a # can't go through a compiler's command line)
  target_compile_definitions(${impl} PRIVATE "FORTE_ACCENT_RGB=\"${rgb}\"")
  # the standalone's icon, its waves in the instrument's colour, where tools/make-icons.py drew one
  set(icons "")
  if (EXISTS ${FORTE_ICON_DIR}/${slug}.icns)
    set(icons STANDALONE_MACOS_ICON ${FORTE_ICON_DIR}/${slug}.icns STANDALONE_WINDOWS_ICON ${FORTE_ICON_DIR}/${slug}.ico)
  endif()
  make_clapfirst_plugins(
    TARGET_NAME forte_${slug}
    IMPL_TARGET ${impl}
    OUTPUT_NAME "${A_NAME}"
    ENTRY_SOURCE ${FORTE_PLUGIN_DIR}/entry.cpp
    BUNDLE_IDENTIFIER "net.jthaler.forte.${slug}"
    BUNDLE_VERSION "${A_VERSION}"
    COPY_AFTER_BUILD FALSE
    WINDOWS_FOLDER_VST3 TRUE
    PLUGIN_FORMATS CLAP VST3 AUV2
    ASSET_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/plugins
    AUV2_MANUFACTURER_NAME "Forte"
    AUV2_MANUFACTURER_CODE "Frte"
    AUV2_SUBTYPE_CODE "${A_AU_SUBTYPE}"
    AUV2_INSTRUMENT_TYPE "aumu"
    STANDALONE_CONFIGURATIONS standalone "${A_NAME}" "net.jthaler.forte.${slug}"
    ${icons}
  )
  # for the Forte app (forte_add_suite): the instrument's forte_instrument() again, under a name
  # of its own, forte_instrument_<slug>, so every instrument can be linked into one program
  if (NOT slug STREQUAL "template")
    set(entry forte_${slug}_suite_entry)
    add_library(${entry} STATIC ${CMAKE_CURRENT_SOURCE_DIR}/${slug}-instrument.cpp)
    target_link_libraries(${entry} PUBLIC ${A_INSTRUMENT})
    target_compile_definitions(${entry} PRIVATE "forte_instrument=forte_instrument_${slug}" "FORTE_INSTRUMENT_VERSION=\"${A_VERSION}\"")
    set_property(GLOBAL APPEND PROPERTY FORTE_SUITE "${slug}|${rgb}")
  endif()
endfunction()

# forte_add_suite()
#
# The Forte app: one standalone with every instrument forte_add_plugin made (but the template),
# switched from the Instrument menu in its window (plugin.h, entrySuite), into
# ${CMAKE_BINARY_DIR}/plugins as "Forte", target forte_suite_standalone. Called after the
# instruments, so a new port joins it with no change here. Its version is Forte's (package.json).
function(forte_add_suite)
  get_property(list GLOBAL PROPERTY FORTE_SUITE)
  file(READ ${FORTE_ROOT}/package.json package)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${FORTE_ROOT}/package.json)
  string(JSON version GET "${package}" version)
  set(decls "")
  set(rows "")
  set(libs "")
  foreach(row ${list})
    string(REPLACE "|" ";" row "${row}")
    list(GET row 0 slug)
    list(GET row 1 rgb)
    string(APPEND decls "const forte::InstrumentInfo &forte_instrument_${slug}();\n")
    string(APPEND rows "  {forte_instrument_${slug}, \"#${rgb}\"},\n")
    list(APPEND libs forte_${slug}_suite_entry)
  endforeach()
  set(src ${CMAKE_BINARY_DIR}/generated/suite-entry.cpp)
  file(GENERATE OUTPUT ${src} CONTENT "// suite-entry.cpp — generated by forte_add_suite() (cmake/forte.cmake): the Forte app's
// instruments, every one forte_add_plugin() made but the template.

#include \"plugin.h\"

${decls}
namespace {
const forte::SuiteEntry instruments[] = {
${rows}};
}

bool forte_entry_init(const char *) { return forte::entrySuite(instruments, (int)(sizeof instruments / sizeof *instruments), \"${version}\"); }
void forte_entry_deinit() {}
const void *forte_entry_get_factory(const char *id) { return forte::entryFactory(id); }
")
  add_library(forte_suite_impl STATIC ${src})
  target_link_libraries(forte_suite_impl PUBLIC forte_plugin ${libs})
  add_executable(forte_suite_standalone ${FORTE_PLUGIN_DIR}/entry.cpp)
  target_link_libraries(forte_suite_standalone PRIVATE forte_suite_impl)
  target_add_standalone_wrapper(TARGET forte_suite_standalone
    OUTPUT_NAME "Forte"
    STATICALLY_LINKED_CLAP_ENTRY TRUE
    PLUGIN_ID "net.jthaler.forte.suite"
    BUNDLE_VERSION "${version}"
    MACOS_ICON ${FORTE_ICON_DIR}/forte.icns
    WINDOWS_ICON ${FORTE_ICON_DIR}/forte.ico)
  if (WIN32) # where clap-wrapper puts the instruments' own standalones
    set_target_properties(forte_suite_standalone PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/plugins/Standalone-forte_suite_standalone)
  else()
    set_target_properties(forte_suite_standalone PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/plugins)
  endif()
endfunction()

# forte_add_wasm(<slug> INSTRUMENT <library> OUT <path.wasm> [SOURCES <model bindings…>])
#
# The instrument's WebAssembly for the website: the engine contract (web/engine-api.cpp) and the
# model functions its views call (SOURCES), as a standalone .wasm with no JavaScript glue
# (shared/wasm.js loads it), copied to OUT, next to the page. It is committed; CI rebuilds it
# with the pinned Emscripten and fails if the committed file differs.
function(forte_add_wasm slug)
  cmake_parse_arguments(A "" "INSTRUMENT;OUT" "SOURCES" ${ARGN})
  set(t forte_${slug}_wasm)
  add_executable(${t} ${FORTE_WEB_DIR}/engine-api.cpp ${A_SOURCES})
  target_link_libraries(${t} PRIVATE ${A_INSTRUMENT})
  set_target_properties(${t} PROPERTIES OUTPUT_NAME ${slug} SUFFIX ".wasm")
  target_compile_options(${t} PRIVATE -fno-exceptions)
  target_link_options(${t} PRIVATE --no-entry -sSTANDALONE_WASM -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=4mb
    -sSTACK_SIZE=256kb -fno-exceptions -sFILESYSTEM=0 -sEXPORTED_FUNCTIONS=_malloc,_free)
  get_filename_component(dir ${A_OUT} DIRECTORY)
  add_custom_command(TARGET ${t} POST_BUILD COMMAND ${CMAKE_COMMAND} -E make_directory ${dir}
                     COMMAND ${CMAKE_COMMAND} -E copy $<TARGET_FILE:${t}> ${A_OUT} VERBATIM)
endfunction()
